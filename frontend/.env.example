# Copy to .env.local. Every value here is optional.
#
# Leave the key blank to drive the IN-PROCESS STUB GATEWAY, which is what the
# backend runs by default (`flashseats.payment.stripe.enabled=false`). The
# checkout page then offers the stub's documented magic tokens, so decline,
# gateway outage and 3-D Secure are all walkable in the browser with no account.
#
# Set it to a `pk_test_...` publishable key to drive the real provider. The
# backend must be started with STRIPE_ENABLED=true and a matching secret key, or
# the two halves disagree about who is charging the card.
VITE_STRIPE_PUBLISHABLE_KEY=

# reCAPTCHA v3 site key, for joining the line (ADR-055). Leave blank and the
# join is sent with no token: the server fails open and relies on rate limits.
# The matching secret is the backend's flashseats.bot.recaptcha.secret.
VITE_RECAPTCHA_SITE_KEY=
