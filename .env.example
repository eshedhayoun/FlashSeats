# FlashSeats — copy to .env and adjust.
#   cp .env.example .env
#
# .env is gitignored. Every value here is a local-development default.

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=flashseats
POSTGRES_USER=flashseats
POSTGRES_PASSWORD=flashseats
POSTGRES_PORT=5432

# --- Redis -------------------------------------------------------------------
REDIS_PORT=6379

# --- RabbitMQ ----------------------------------------------------------------
RABBITMQ_USER=flashseats
RABBITMQ_PASSWORD=flashseats
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# --- Mailpit -----------------------------------------------------------------
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Nginx (cluster profile) -------------------------------------------------
HTTP_PORT=8080

# --- Application secrets -----------------------------------------------------
# Three HMAC keys, one per token domain: the `fsid` cookie (ADR-010), queue pass
# and admission tokens (ADR-006/020), and receipt links (ADR-010). They are
# SEPARATE on purpose — one shared value meant a single leak forged all three,
# and rotating any of them rotated the others (ADR-039). Rotating a secret
# invalidates every live token it signs, so do not rotate mid-sale.
#
# Generate one value each:
#   openssl rand -base64 48
#
# `dev-only-change-me` is the published default and is fine for `dev` and
# `test`. Anywhere else — including `docker compose --profile cluster`, which
# runs the `docker` profile — SecretsGuard REFUSES TO START until these carry
# real values. That is deliberate: a default secret breaks nothing visible, so
# a startup that stops is the only signal that cannot be missed.
FLASHSEATS_SESSION_SECRET=dev-only-change-me
FLASHSEATS_QUEUE_PASS_SECRET=dev-only-change-me
FLASHSEATS_RECEIPT_SECRET=dev-only-change-me

# --- Admin (HTTP Basic on /api/v1/admin/** and /actuator/**) -----------------
# Also checked by SecretsGuard: `admin` is refused outside dev/test.
FLASHSEATS_ADMIN_USERNAME=admin
FLASHSEATS_ADMIN_PASSWORD=admin

# --- Proxy trust (cluster profile) -------------------------------------------
# Peer addresses whose X-Forwarded-For the rate limiter believes (ADR-039).
# EMPTY MEANS TRUST NOBODY, which is correct with nothing in front of the app.
#
# RateLimitService.isTrustedProxy is exact-address set membership — ADR-039
# chose that over a CIDR parser deliberately, because this is the one check that
# decides whether the rate limiter can be bypassed. An exact address means the
# proxy needs a FIXED one, which is why compose pins nginx to 172.28.0.10 rather
# than letting the bridge assign it.
#
# Left empty the cluster still runs, and every one of ten thousand buyers shares
# nginx's single IP bucket (capacity 300, refill 150/s). That is not a subtle
# degradation: it throttles the entire sale at once (ADR-047).
FLASHSEATS_TRUSTED_PROXIES=172.28.0.10

# Set true wherever TLS terminates. A `Secure` cookie is silently dropped over
# plain HTTP, which would give every request a fresh identity.
FLASHSEATS_COOKIE_SECURE=false

# --- Stripe (Phase 3) --------------------------------------------------------
# Test-mode keys only. For local webhooks:
#   stripe listen --forward-to localhost:8080/api/v1/payments/webhook
# which prints the whsec_... value to use below.
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- reCAPTCHA v3 (Phase 3) --------------------------------------------------
# Leave blank locally: the bot module fails open when verification is
# unavailable and flags the request as degraded (ADR-011).
RECAPTCHA_SECRET=

# --- k6 load harness (Phase 4) -----------------------------------------------
# EVENT/TIER 9001 is the reserved load-test sale seeded by docker/seed/seed.sh.
# Not 1: the postgres volume outlives a run and CatalogDevSeeder already owns
# ids 1 and 2, so seeding id 1 silently deferred to its 700-seat event while the
# harness asserted a capacity of 500 (ADR-047).
#
# K6_VUS=10000 is the Phase 4 target and wants roughly 32 GB on the host — three
# JVMs take ~6 GB and k6 costs ~0.33 MB per VU. Override per run:
#   docker compose --profile loadtest run --rm -e VUS=2000 k6
K6_BASE_URL=http://nginx:80
K6_EVENT_ID=9001
K6_TIER_ID=9001
K6_VUS=10000
K6_CAPACITY=500
